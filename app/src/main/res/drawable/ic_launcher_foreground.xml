<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground — 108×108dp canvas.
  Safe zone: 21dp–87dp on both axes (66×66dp inner area).

  Design: billfold wallet with a credit card peeking from the top and a
  coin-pocket circle bump on the right side.  All elements are white on a
  transparent background so they composite cleanly over any background
  colour (teal solid in ic_launcher_background.xml).

  Drawing order (back to front):
    1. Card  — white 80 % opacity, rounded rect above the wallet body
    2. Coin  — white solid circle whose left half will be covered by the wallet,
               leaving a D-shaped coin-pocket bump visible on the right
    3. Wallet body — white solid rounded rect, covers coin's left half
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      Card (behind wallet, peeking above the wallet top edge at y=40).
      Rounded rect: left=35 top=30 right=61 bottom=46  rx=4
      Visible area above wallet: y=30–40 (10 units).
      Safe zone check: x 35–61 ✓  y 30–46 ✓
    -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.80"
        android:pathData="M39,30 H57 A4,4,0,0,1,61,34 V42 A4,4,0,0,1,57,46 H39 A4,4,0,0,1,35,42 V34 A4,4,0,0,1,39,30 Z" />

    <!--
      Coin pocket — solid white circle, center=(76,58) radius=11.
      Drawn before the wallet so the wallet covers the left half (x 65–76).
      Only the right D-shaped half (x 76–87) is visible against the teal background,
      forming a recognisable coin-pocket bump.
      Safe zone check: right extent 76+11=87 ✓  top/bottom 58±11=47/69 ✓
    -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M87,58 A11,11,0,1,0,65,58 A11,11,0,1,0,87,58 Z" />

    <!--
      Wallet body — main billfold shape.
      Rounded rect: left=24 top=40 right=76 bottom=76  rx=7
      Covers the coin circle from x=24–76, leaving the right bump visible.
      Safe zone check: x 24–76 ✓  y 40–76 ✓
    -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M31,40 H69 A7,7,0,0,1,76,47 V69 A7,7,0,0,1,69,76 H31 A7,7,0,0,1,24,69 V47 A7,7,0,0,1,31,40 Z" />

</vector>
